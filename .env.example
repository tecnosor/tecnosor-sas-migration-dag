# SASsessment environment configuration example.
# Copy to .env and adjust. Offline/file-first mode requires NO secrets.
# All values are optional; sane defaults live in config/default.yaml.
# Precedence: defaults < config/default.yaml < environment variables < explicit CLI flags.

# --- Core ---
# Path to the SASsessment repository/workspace root (defaults to repo containing pyproject.toml)
SASSESSMENT_WORKSPACE_ROOT=
# Override the SQLite database path (defaults to workspace/database/sassessment.db)
SASSESSMENT_DATABASE_PATH=
# Active assessment id (defaults to the single assessment in state)
SASSESSMENT_ACTIVE_ASSESSMENT=

# --- OpenCode execution backend ---
SASSESSMENT_OPENCODE_EXECUTABLE=opencode
SASSESSMENT_OPENCODE_MODEL=opencode-go/glm-5.3-flash
# Seconds before a node invocation is cancelled
SASSESSMENT_OPENCODE_TIMEOUT_SECONDS=600
# Force MockAdapter even when the CLI is present (offline-safe default is auto)
SASSESSMENT_OPENCODE_FORCE_MOCK=

# --- Limits ---
SASSESSMENT_MAX_RETRIES=2
SASSESSMENT_MAX_GRAPH_CYCLES=25
SASSESSMENT_MAX_NODE_ATTEMPTS=5
SASSESSMENT_LINEAGE_MAX_DEPTH=2
SASSESSMENT_LINEAGE_MAX_ITERATIONS=3
SASSESSMENT_EVIDENCE_MAX_BYTES=52428800

# --- Connectors (all disabled by default; file-first operation needs none) ---
SASSESSMENT_CONNECTOR_DATABASE=false
SASSESSMENT_CONNECTOR_GITLAB=false
SASSESSMENT_CONNECTOR_CONFLUENCE=false
# Live queries always require explicit human approval regardless of this flag
SASSESSMENT_APPROVAL_POLICY=explicit

# --- Safety ---
# Additional regex patterns for secret redaction in logs/audit (comma separated)
SASSESSMENT_REDACTION_PATTERNS=
